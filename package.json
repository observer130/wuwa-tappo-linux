{
  "name": "wuwa-tappo-linux",
  "version": "1.0.2-2",
  "description": "Linux community port of the Wuwa Tappo CN desktop pet",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/observer130/wuwa-tappo-linux.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "extract": "node scripts/extract-assets.mjs",
    "inventory": "node scripts/inventory-contract.mjs",
    "prepare:frontend": "node scripts/prepare-frontend.mjs",
    "scaffold": "node scripts/scaffold-frontend.mjs",
    "icons": "tauri icon frontend/app-icon.png --output src-tauri/icons",
    "dev": "npm run prepare:frontend && tauri dev",
    "build": "npm run prepare:frontend && tauri build --bundles deb",
    "package": "bash scripts/package-linux.sh",
    "test": "node --test tests/*.test.mjs",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "check": "npm test && npm run test:rust",
    "assets:sync": "node scripts/sync-upstream.mjs",
    "upstream:check": "node scripts/sync-upstream.mjs --check",
    "upstream:update": "node scripts/sync-upstream.mjs --update-lock"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "acorn": "^8.15.0"
  }
}
